# Copy to .env.local for local development, then restart `npm run dev`.
# NEXT_PUBLIC_* values are inlined at build time — changing them needs a restart.

# dev: http://localhost:5300/v1; prod: https://api.aquakart.co.in/v1
# Restart the dev server after changing MODE; rebuild for production.
MODE=dev
# Optional override for the server-side invoice backend only.
INVOICE_API_URL=

# Required for Google sign-in. Firebase console > Project settings > Your apps
# > SDK setup and configuration. Without these, "Continue with Google" fails on
# localhost with auth/invalid-api-key and only email OTP login works.
# Also add "localhost" under Authentication > Settings > Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Google One Tap, the in-page "Sign in with google.com" card (no popup)
# on /aqua. Use the Web client ID from Firebase > Authentication > Google > Web
# SDK configuration, and add this site's origin (e.g. http://localhost:3000)
# under its Authorized JavaScript origins in Google Cloud > Credentials.
# Empty: sign-in uses the Firebase popup as before.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
