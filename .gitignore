# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.env
# testing
/coverage

# npm is the package manager: package-lock.json is committed so Docker can
# run a fast, reproducible `npm ci`. Other lockfiles must not come back.
/pnpm-lock.yaml
/yarn.lock



# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Google service-account credentials
/aquakart.json
